# SQLite dosyası (yerelde proje köküne yazılır). Yayında Turso: libsql://<db>.turso.io
DATABASE_URL=file:./cakatech.db
# Yalnızca Turso için (yerelde boş bırak)
DATABASE_AUTH_TOKEN=
# Uzun, rastgele bir değer: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Yalnızca Vercel Blob için (Vercel otomatik ekler; yerelde boş bırak → görseller media/ klasörüne)
BLOB_READ_WRITE_TOKEN=
# Sponsor başvurusu bildirim maili (Resend: resend.com). Boşsa mail gönderilmez, başvuru yine panele düşer.
RESEND_API_KEY=
# Gönderen adres: Resend'de doğrulanmış alan adı gerekir. Boşsa onboarding@resend.dev (yalnızca Resend hesabının e-postasına gönderebilir).
EMAIL_FROM_ADDRESS=
# Bildirimin gideceği adres (boşsa cakatechftc@gmail.com)
INQUIRY_NOTIFY_TO=
